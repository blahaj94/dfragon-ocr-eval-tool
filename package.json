{
  "name": "dfragon-ocr-eval-tool",
  "version": "0.1.1",
  "private": true,
  "description": "Local evaluation of ldb-ocr checkpoints against labeled Cropper ROIs",
  "main": "out/backend/main.js",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "pnpm typecheck && electron-vite build",
    "package:win": "pnpm build && electron-builder --win --x64 --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ui": "pnpm build && playwright test",
    "test:python": "uv run --project python --group dev pytest -q python/tests",
    "lint:python": "uv run --project python --group dev ruff check python",
    "format:python:check": "uv run --project python --group dev ruff format --check python"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "7.2.6",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
