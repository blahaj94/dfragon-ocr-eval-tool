{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/backend/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/frontend/src/env.d.ts",
    "e2e/**/*.ts"
  ]
}
